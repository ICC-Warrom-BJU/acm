# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Melewati RLS. Hanya untuk sisi server — jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Enkripsi token sumber alert (PRD §10) ---
# Buat dengan: openssl rand -base64 32
ACM_ENCRYPTION_KEY=

# --- Rahasia endpoint internal ---
# Harus SAMA PERSIS dengan public.app_settings.internal_secret di database,
# karena pg_cron memakainya untuk memanggil /api/internal/*.
# Buat dengan: openssl rand -hex 32
ACM_INTERNAL_SECRET=

# --- Token TMS EASYGO (hanya dipakai skrip seed, tidak dibaca aplikasi) ---
EASYGO_TOKEN=
